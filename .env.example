# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# AvalAI API Key (optional alternative AI provider for Whisper & GPT)
AVALAI_API_KEY=""

# Supabase Configurations (optional for external backend sync)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Email / SMTP Configuration for Password Reset (Optional - defaults to simulated preview if not set)
# For Gmail:
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
# Or generic SMTP:
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="no-reply@factorchi.ir"
SMTP_SECURE="false"

